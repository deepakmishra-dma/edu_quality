 "html": "<style>td, th {\r\n    border: 1px solid gray;\r\n}\r\n.center-cell{\r\ntext-align:center;\r\nvertical-align:middle;\r\n\r\n}table {\r\n    table-layout: fixed;\r\n    width: 100%; /* Set the width of the table */\r\n}\r\n\r\ntable td {\r\n    word-wrap: break-word; /* Ensure long words wrap to the next line */\r\n}\r\ntable .break-all{\r\nword-break: break-all;\r\n}\r\n</style>\r\n\r\n<table >\r\n  <thead>\r\n  <tr><th colspan=\"2\" class=\"center-cell\"><img width=\"150\" height=\"150\" src=\"{{doc.custom_qr_code_base}}\"/></th>\r\n\r\n      <th colspan=\"6\"class=\"center-cell\" ><div>Purchase Receipt No: {{doc.name}}</div><div>Date:{{frappe.utils.nowdate()}}</th>\r\n   \r\n \r\n   \r\n    </tr>\r\n   \r\n    <tr>\r\n      <th>Item Group</th>\r\n      <th>Item Code</th>\r\n      <th>Quantity</th>\r\n        <th colspan=\"2\">Chapter</th>\r\n        <th>Subject</th>\r\n        <th>Class</th>\r\n            \r\n    </tr>\r\n  </thead>\r\n  \r\n  <tbody> {% for item in doc.items %}\r\n  {% set item_details = frappe.get_doc(\"Item\",item.item_name) %}\r\n    <tr>\r\n      <td>{{ item.item_group }} </td>\r\n      <td>{{ item.item_code }}</td>\r\n      <td>{{item.qty}}</td>\r\n      <td colspan=\"2\">{{item_details.custom_chapter}}</td>\r\n  <td>{{item_details.custom_subject}}</td>\r\n  <td>{{item_details.custom_class}}</td>\r\n    </tr>\r\n    {% endfor %}\r\n    </tbody>\r\n</table>",
