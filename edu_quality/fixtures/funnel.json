    "data": "{\n    \"node_label\": \"Get Details of Student\",\n    \"python_code\": \"# do required updates\\n# update variable e.g.\\ndoc = variables.get(\\\"doc\\\")\\n\\nacad_year = frappe.db.get_value(doc.reference_doctype, doc.reference_name, \\\"academic_year\\\")\\n\\nfirst_name = frappe.db.get_value(\\\"Student\\\", doc.party, \\\"first_name\\\")\\nmiddle_name = frappe.db.get_value(\\\"Student\\\", doc.party, \\\"middle_name\\\")\\nlast_name = frappe.db.get_value(\\\"Student\\\", doc.party, \\\"last_name\\\")\\nreference_number = frappe.db.get_value(\\\"Student\\\", doc.party, \\\"reference_number\\\")\\n\\n\\nemail = frappe.db.get_value(\\\"Student\\\", doc.party, \\\"student_email_id\\\")\\n\\npayment_plan = frappe.db.get_value(doc.reference_doctype, doc.reference_name, \\\"payment_plan\\\")\\n\\npayplan_doc = frappe.get_doc(\\\"Payment Plan\\\", payment_plan)\\ninst_count = len(payplan_doc.payment_schedule)\\n\\nvariables[\\\"first_name\\\"] = first_name\\nvariables[\\\"middle_name\\\"] = middle_name\\nvariables[\\\"last_name\\\"] = last_name\\nvariables[\\\"acad_year\\\"] = acad_year\\nvariables[\\\"link\\\"] = doc.payment_url\\nvariables[\\\"refno\\\"] = reference_number\\nvariables[\\\"inst_count\\\"] = inst_count\\nvariables[\\\"recipient\\\"] = email\",\n    \"submit\": true,\n    \"variable_path_for_output\": \"\"\n}",
