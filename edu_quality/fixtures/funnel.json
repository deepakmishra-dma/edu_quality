    "data": "{\n    \"node_label\": \"Get Context\",\n    \"python_code\": \"doc = variables.get(\\\"doc\\\")\\n\\nemail = frappe.db.get_value(\\\"Student\\\", doc.student, \\\"student_email_id\\\")\\n\\nstudent_doc = frappe.get_doc(\\\"Student\\\", doc.student)\\npdf = frappe.db.get_value(\\n    \\\"Rules and Regulation Template\\\",\\n    doc.rules_and_regulation_template,\\n    \\\"pdf\\\",\\n)\\n\\nsite_url = frappe.utils.get_url()\\npdf_url = site_url + pdf\\n\\nfirst_name = student_doc.first_name\\nfather_name = frappe.db.get_value(\\n    \\\"Student Guardian\\\", {\\\"parent\\\": doc.student, \\\"relation\\\": \\\"Father\\\"}, \\\"guardian_name\\\"\\n)\\nmother_name = frappe.db.get_value(\\n    \\\"Student Guardian\\\", {\\\"parent\\\": doc.student, \\\"relation\\\": \\\"Mother\\\"}, \\\"guardian_name\\\"\\n)\\ncontext = {\\n    \\\"refno\\\": student_doc.reference_number,\\n    \\\"first_name\\\": first_name.capitalize() if first_name else \\\"\\\",\\n    \\\"mother_name\\\": mother_name.capitalize() if mother_name else \\\"\\\",\\n    \\\"father_name\\\": father_name.capitalize() if father_name else \\\"\\\",\\n    \\\"submitted_with_response\\\": doc.submitted_with_response,\\n    \\\"submitted_date\\\": doc.submitted_date,\\n    \\\"otp_entered\\\": doc.otp_entered,\\n    \\\"otp_sent_to_number\\\": doc.otp_sent_to_contact_no,\\n    \\\"otp_sent_to_email\\\": doc.otp_sent_to_email_id,\\n    \\\"ip_address\\\": doc.ip_address,\\n    \\\"user_info\\\": doc.user_info,\\n    \\\"link\\\": pdf_url,\\n}\\n\\nvariables[\\\"extra_email_args\\\"] = {}\\nvariables[\\\"extra_email_args\\\"][\\\"attachments\\\"] = [{\\\"doctype\\\": doc.doctype, \\\"name\\\":doc.name}]\\nvariables[\\\"recipient\\\"] = email\\nvariables[\\\"context\\\"] = context\",\n    \"submit\": true,\n    \"variable_path_for_output\": \"\"\n}",
